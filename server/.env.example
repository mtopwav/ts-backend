# Copy to .env for production (NODE_ENV=production).
# Do not commit real passwords.

NODE_ENV=production
PORT=5001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=thiago_db

# Comma-separated, no trailing slash — must match the browser origin(s)
CLIENT_URL=https://your-domain.com,http://localhost:5001

# Onfon SMS (optional)
# ONFON_ACCESS_KEY=
# ONFON_API_KEY=
# ONFON_CLIENT_ID=
# ONFON_SENDER_ID=
