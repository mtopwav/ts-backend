# Copy to .env for production (NODE_ENV=production).
# Do not commit real passwords.

NODE_ENV=production
PORT=5001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=thiago_db

# Browser origins (no trailing slash)
CLIENT_URL=https://www.ts-autoparts.co.tz,https://ts-autoparts.co.tz,http://www.ts-autoparts.co.tz,http://ts-autoparts.co.tz

# Onfon SMS (optional)
# ONFON_ACCESS_KEY=
# ONFON_API_KEY=
# ONFON_CLIENT_ID=
# ONFON_SENDER_ID=
